{
 "version": "2.0.0",
 "tasks": [
  {
   "type": "cppbuild",
   "label": "C/C++: g++.exe (UCRT) 生成活动文件",
   "command": "C:/msys64/ucrt64/bin/g++.exe",
   "args": [
    "-g",
    "-std=c++20",
    "${file}",
    "-o",
    "${fileDirname}\\result.exe"
   ],
   "options": {
    "cwd": "${fileDirname}"
   },
   "problemMatcher": [
    "$gcc"
   ],
   "group": {
    "kind": "build",
    "isDefault": true
   },
   "detail": "调试器生成的任务。"
  },
  {
   "type": "cppbuild",
   "label": "C/C++: gcc.exe 生成活动文件",
   "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
   "args": [
    "-fdiagnostics-color=always",
    "-g",
    "${file}",
    "-o",
    "${fileDirname}\\result.exe"
   ],
   "options": {
    "cwd": "${fileDirname}"
   },
   "problemMatcher": [
    "$gcc"
   ],
   "group": {
    "kind": "build",
    "isDefault": true
   },
   "detail": "调试器生成的任务。"
  },
 ]
}