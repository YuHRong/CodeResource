// Write a C++ program that displays mixed data types and arithmetic operations.

#include <iostream>
#include <iomanip> // 包含格式化的头文件

using namespace std;

int main()
{
 int i = 5, j = 7;        // 申明并初始化两个整数变量
 double x = 3.7, y = 8.0; // 申明并初始化两个双精度浮点数

 cout << "Display arithmetic operations with mixed data type :\n";
 cout << "---------------------------------------------------------\n";

 // 将浮点数输出设为固定一位小数
 cout << fixed << setprecision(1);

 cout << i << " + " << j << " = " << i + j << endl; // 整数加法
 cout << x << " + " << y << " = " << x + y << endl; // 双精度浮点数 加法
 cout << i << " + " << y << " = " << i + y << endl; // 一个整数和一个双精度浮点数相加
 cout << i << " - " << j << " = " << i - j << endl; // 整数减法
 cout << x << " - " << y << " = " << x - y << endl; // 双精度浮点数减法
 cout << i << " - " << y << " = " << i - y << endl; // 整数双精度浮点数减法
 cout << i << " * " << j << " = " << i * j << endl; // 整数乘法
 cout << x << " * " << y << " = " << x * y << endl; // 双精度浮点数乘法
 cout << i << " * " << y << " = " << i * y << endl; // 整数乘以双精度浮点数
 cout << i << " / " << j << " = " << i / j << endl; // 整数除法
 cout << x << " / " << y << " = " << x / y << endl; // 双精度浮点数除法
 cout << i << " / " << y << " = " << i / y << endl; // 一个整数除以一个双精度浮点数

 return 0;
}