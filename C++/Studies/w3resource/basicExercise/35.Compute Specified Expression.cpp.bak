// Write a program in C++ to compute the specified expressions and print the output.

#include <iostream>

using namespace std;

int main()
{

 cout << "Compute the specified expressions and print the output:\n";
 cout << "------------------------------------------------------------\n";

  cout << "Result of the expression  (25.5 * 3.5 - 3.5 * 3.5) / (40.5 - 4.5) is : " // 打印表达式消息
      << (25.5 * 3.5 - 3.5 * 3.5) / (40.5 - 4.5)                                   // 计算表达式
      << '\n';

 return 0;
}